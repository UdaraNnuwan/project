OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# ── GenAI / Two-Tier Verification ──────────────────────────────────────────
GENAI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
TIER1_MIN_SCORE_RATIO=1.05
TIER2_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-1003954657971
TELEGRAM_CHANNEL_ID=-1003954657971
MODEL_MODE=hybrid
ALPHA=0.6
BETA=0.4
FORECAST_HORIZON=1
FORECAST_HIDDEN_SIZE=64
FORECAST_NUM_LAYERS=1
FORECAST_DROPOUT=0.0
CONTAINER_AD_RAW_DATA_DIR=.\data\raw
CONTAINER_AD_DATASET_OUTPUT_DIR=.\data\processed
CONTAINER_AD_MODEL_DIR=.\models
CONTAINER_AD_RESULTS_DIR=.\results
CONTAINER_AD_GPT_RESULTS_DIR=.\results
